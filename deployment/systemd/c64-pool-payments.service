[Unit]
Description=C64 Chain pool: payment processor (sendmany from the pool wallet; emergency brake: deployment/pause-payments.sh)
After=c64-pool-redis.service c64-node.service c64-wallet-rpc.service
Requires=c64-pool-redis.service
[Service]
Type=simple
User=c64pool
WorkingDirectory=/opt/c64-nodejs-pool
ExecStart=/usr/bin/node /opt/c64-nodejs-pool/init.js -module=payments
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
