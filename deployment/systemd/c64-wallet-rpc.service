[Unit]
Description=C64 Chain pool wallet (wallet-rpc, 127.0.0.1:19643, no password: local use only)
After=c64-node.service
Requires=c64-node.service

[Service]
Type=simple
User=c64pool
ExecStart=/opt/c64/bin/c64chain-wallet-rpc-mainnet --wallet-file /opt/c64/wallet/pool --password-file /opt/c64/wallet/password --rpc-bind-ip 127.0.0.1 --rpc-bind-port 19643 --disable-rpc-login --daemon-address 127.0.0.1:19641 --trusted-daemon --log-file /opt/c64/wallet/wallet-rpc.log --max-log-file-size 0
Restart=on-failure
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
